{
  "name": "movie-watcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test scripts/*.test.mjs",
    "test:rules": "node scripts/rules-test.mjs",
    "inspect": "node scripts/inspect.mjs",
    "test:push": "node scripts/test-push.mjs",
    "test:e2e": "node scripts/e2e-check.mjs",
    "announce": "node scripts/broadcast.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "check": "node scripts/check-availability.mjs",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/manrope": "^5.2.5",
    "firebase": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "firebase-admin": "^13.4.0",
    "sharp": "^0.34.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  }
}
