# Copy to .env.local and fill in. All VITE_ vars ship in the client bundle (public by design).

# TMDB v4 Read Access Token — free at https://www.themoviedb.org/settings/api
VITE_TMDB_TOKEN=

# Firebase web app config — Firebase Console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate key pair — Firebase Console > Project settings > Cloud Messaging > Web Push certificates
VITE_FCM_VAPID_KEY=

# Google AdSense publisher ID (ca-pub-XXXX). Placeholders render while empty.
# WARNING: setting this while using TMDB's free API breaches their terms (§2.A
# treats ad revenue as commercial use). Read "Monetization" in the README first.
VITE_ADSENSE_CLIENT=
